{
  "colors": {
    "scheme": "dark",
    "accent": "#2563eb"
  },
  "layout": {
    "design": "landscape",
    "flow": [
      {
        "zone": "head",
        "span": 9,
        "height": "170px"
      },
      {
        "zone": "clock",
        "span": 3,
        "height": "170px"
      },
      {
        "zone": "menu",
        "span": 6,
        "height": 2
      },
      {
        "zone": "info",
        "span": 6,
        "height": 2
      },
      {
        "zone": "news",
        "height": "110px"
      }
    ]
  },
  "zones": {
    "head": {
      "type": "heading",
      "text": "Today's lunch"
    },
    "clock": {
      "type": "clock",
      "surface": "raised",
      "show_date": true
    },
    "menu": {
      "type": "table",
      "title": "Menu",
      "columns": ["Dish", "Diet", "Price"],
      "align": ["start", "start", "end"],
      "rows": {
        "bind": "/menu"
      }
    },
    "info": {
      "type": "stack",
      "items": [
        {
          "type": "stack",
          "direction": "row",
          "items": [
            {
              "type": "stat",
              "title": "Wait time",
              "value": {
                "bind": "/wait"
              },
              "unit": "min"
            },
            {
              "type": "stat",
              "title": "Seats free",
              "value": {
                "bind": "/seats"
              }
            }
          ]
        },
        {
          "type": "stack",
          "direction": "row",
          "items": [
            {
              "type": "list",
              "title": "Notices",
              "items": {
                "bind": "/notices"
              }
            },
            {
              "type": "text",
              "surface": "accent",
              "title": "Allergens",
              "fit": true,
              "text": "Ask at the counter for allergen information."
            }
          ]
        }
      ]
    },
    "news": {
      "type": "cycle",
      "surface": "raised",
      "items": {
        "bind": "/messages"
      },
      "seconds": 8
    }
  }
}
