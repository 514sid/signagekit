---
import Base from './Base.astro'
import { DOCS, REPO, type DocPage } from '../lib/docs'

interface Props {
  page: DocPage
  description: string
  sections: { slug: string; text: string }[]
  /** Repository path of the file this page is written in. */
  source: string
}

const { page, description, sections, source } = Astro.props
const at = DOCS.indexOf(page)
const prev = DOCS[at - 1]
const next = DOCS[at + 1]
---

<Base title={page.title} description={description} section="docs">
  <div
    class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-8 sm:px-6 lg:grid-cols-[13rem_minmax(0,1fr)] lg:py-12 xl:grid-cols-[13rem_minmax(0,1fr)_12rem]"
  >
    <nav aria-label="Docs" class="lg:sticky lg:top-24 lg:self-start">
      <ul class="flex gap-1 overflow-x-auto border-b border-line pb-3 text-sm lg:flex-col lg:border-0 lg:pb-0">
        {
          DOCS.map((d) => (
            <li>
              <a
                href={d.path}
                aria-current={d === page ? 'page' : undefined}
                class="block whitespace-nowrap rounded-md px-3 py-1.5 text-muted hover:bg-soft hover:text-fg aria-[current=page]:bg-soft aria-[current=page]:font-semibold aria-[current=page]:text-fg"
              >
                {d.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <main id="main" class="min-w-0">
      <slot />

      <div class="mt-16 flex max-w-[46rem] flex-wrap justify-between gap-4 border-t border-line pt-6 text-sm">
        {
          prev ? (
            <a href={prev.path} class="group flex flex-col">
              <span class="text-muted">Previous</span>
              <span class="font-semibold text-accent group-hover:text-accent-hover group-hover:underline">
                {prev.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={next.path} class="group flex flex-col text-right">
              <span class="text-muted">Next</span>
              <span class="font-semibold text-accent group-hover:text-accent-hover group-hover:underline">
                {next.title}
              </span>
            </a>
          )
        }
      </div>
      <p class="mt-6 text-sm">
        <a class="text-muted underline-offset-2 hover:text-fg hover:underline" href={`${REPO}/edit/main/${source}`}>
          Edit this page on GitHub
        </a>
      </p>
    </main>

    {
      sections.length > 0 && (
        <aside aria-label="On this page" class="hidden xl:sticky xl:top-24 xl:block xl:self-start">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted">On this page</p>
          <ul class="max-h-[calc(100vh-8rem)] space-y-1.5 overflow-y-auto border-l border-line text-sm">
            {sections.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="-ml-px block border-l border-transparent pl-3 text-muted hover:border-fg hover:text-fg"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>
