---
import { Code } from 'astro:components'
import Base from '../layouts/Base.astro'
import { readRepo } from '../lib/examples'

const lunch = {
  layout: readRepo('examples/lunch/layout.yml'),
  data: readRepo('examples/lunch/data.yml'),
}
const sizes: [string, string][] = [
  ['Full HD', '1920x1080'],
  ['4:3', '1024x768'],
  ['Ultrawide', '2560x1080'],
  ['Portrait', '1080x1920'],
]
const steps = [
  {
    title: 'Write the template',
    text: 'The agent writes JSON or YAML against a JSON Schema: named zones and a component in each, from tables and stats to charts, schedules and alerts. No CSS and no pixel values.',
    code: '# yaml-language-server: $schema=https://signagekit.514sid.com/schema.json',
  },
  {
    title: 'Check it',
    text: 'The checker lists every problem with its exact path, so a model can repair its own template without seeing the screen.',
    code: 'npx @514sid/signagekit check menu.layout.yml menu.data.yml',
  },
  {
    title: 'Look at it',
    text: 'A preview link renders the screen at several resolutions. The agent screenshots it and fixes what looks cramped or empty.',
    code: 'npx @514sid/signagekit url menu.layout.yml menu.data.yml --mode sizes',
  },
  {
    title: 'Update the data',
    text: 'After that, the agent or a script only rewrites the data. The checked template stays as it is, so a new value can never break the layout.',
    code: 'await screen.update({ data: { wait: 12 } })',
  },
]
const points = [
  {
    title: 'Components, not sizes',
    text: 'Agents choose what goes where. signagekit sizes all the text as one design, keeps it readable, and lets long lists say how many rows didn\'t fit.',
  },
  {
    title: 'Alerts in the data',
    text: 'One alert block covers everything from a fire alarm to a maintenance notice, with an icon and numbered steps. An agent raises or clears it by writing data.',
  },
  {
    title: 'Light enough for players',
    text: '39 KB of JavaScript, no web fonts, and only the components a screen uses get loaded, so it runs on the low-end devices behind most screens.',
  },
  {
    title: 'Examples to start from',
    text: 'Menus, dashboards, schedules, queues and alerts, each a folder with a layout and its data, ready to copy and change.',
    link: { href: '/examples/', label: 'Browse the examples' },
  },
]
---

<Base
  title="a digital signage toolkit for AI agents"
  description="A toolkit for AI agents that build dashboards, menus, schedules and alerts for digital signage screens."
  section="home"
>
  <main id="main" class="mx-auto w-full max-w-6xl px-4 pt-16 pb-24 sm:px-6 sm:pt-24">
    <section class="max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-6xl">
        A digital signage toolkit for AI agents
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg text-muted">
        signagekit is a toolkit for agents that build dashboards, menus, schedules and alerts for signage
        screens. The agent writes a short JSON or YAML template. signagekit lays it out for any display,
        sizes every piece of text, and gives the agent a way to check and see its work.
      </p>
      <pre
        class="mt-8 inline-block rounded-lg border border-line bg-soft px-4 py-2.5 font-mono text-sm"><code>npm install @514sid/signagekit</code></pre>
      <div class="mt-6 flex items-center gap-6">
        <a
          href="/docs/"
          class="rounded-md bg-accent px-4 py-2 font-semibold text-on-accent hover:bg-accent-hover"
        >
          Get started
        </a>
        <a href="/docs/assistants/" class="font-medium text-accent underline-offset-2 hover:text-accent-hover hover:underline">
          Guide for agents
        </a>
      </div>
    </section>

    <section aria-labelledby="steps-title" class="mt-24">
      <h2 id="steps-title" class="text-2xl font-semibold tracking-tight">How an agent builds a screen</h2>
      <ol class="mt-8 grid gap-x-10 gap-y-10 md:grid-cols-2">
        {
          steps.map((step, i) => (
            <li class="flex gap-4">
              <span
                aria-hidden="true"
                class="flex size-8 flex-none items-center justify-center rounded-full border border-line font-mono text-sm text-muted"
              >
                {i + 1}
              </span>
              <div class="min-w-0">
                <h3 class="font-semibold">{step.title}</h3>
                <p class="mt-1.5 text-muted">{step.text}</p>
                <pre class="mt-3 overflow-x-auto rounded-md border border-line bg-soft px-3 py-2 font-mono text-[0.8125rem]"><code>{step.code}</code></pre>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="demo-title" class="mt-24">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 id="demo-title" class="text-2xl font-semibold tracking-tight">One template, every display</h2>
          <p class="mt-1 text-muted">A lunch menu from the examples, written once for landscape.</p>
        </div>
        <div class="segmented" role="group" aria-label="Screen resolution">
          {
            sizes.map(([label, size], i) => (
              <button type="button" data-size={size} aria-pressed={i === 0 ? 'true' : 'false'}>
                {label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="flex min-h-72 items-center justify-center rounded-xl border border-line bg-soft p-4 sm:p-6">
        <div
          id="demo"
          class="aspect-video w-full data-[portrait]:h-[min(70vh,40rem)] data-[portrait]:w-auto"
        >
        </div>
      </div>
      <details class="group mt-4">
        <summary class="cursor-pointer text-muted hover:text-fg">The template and data behind it</summary>
        <div class="mt-3 grid gap-4 md:grid-cols-[1.4fr_1fr] [&_pre]:rounded-lg [&_pre]:border [&_pre]:border-line [&_pre]:p-4 [&_pre]:text-sm">
          <Code code={lunch.layout} lang="yaml" themes={{ light: 'github-light', dark: 'github-dark' }} />
          <Code code={lunch.data} lang="yaml" themes={{ light: 'github-light', dark: 'github-dark' }} />
        </div>
      </details>
      <script is:inline type="application/json" id="demo-source" set:html={JSON.stringify(lunch).replace(/</g, '\\u003c')} />
    </section>

    <section class="mt-24" aria-labelledby="why-title">
      <h2 id="why-title" class="text-2xl font-semibold tracking-tight">Why it works for agents</h2>
      <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        points.map((p) => (
          <div>
            <h3 class="font-semibold">{p.title}</h3>
            <p class="mt-2 text-muted">
              {p.text}{' '}
              {p.link && (
                <a class="text-accent underline-offset-2 hover:text-accent-hover hover:underline" href={p.link.href}>
                  {p.link.label}
                </a>
              )}
            </p>
          </div>
        ))
      }
      </div>
    </section>
  </main>
  <script>
    import '../scripts/home.ts'
  </script>
</Base>

