{
  "name": "@514sid/signagekit",
  "version": "0.0.3",
  "description": "A toolkit for AI agents that build digital signage screens: dashboards, menus, schedules and alerts as JSON or YAML templates, laid out for any display.",
  "keywords": [
    "ai",
    "ai-agents",
    "dashboard",
    "declarative",
    "digital-signage",
    "display",
    "layout",
    "llm",
    "preact",
    "signage",
    "templates",
    "yaml"
  ],
  "license": "MIT",
  "author": "514sid",
  "homepage": "https://signagekit.514sid.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/514sid/signagekit.git"
  },
  "bugs": "https://github.com/514sid/signagekit/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "signagekit": "./bin/signagekit.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "bin",
    "schema.json",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check-all && bun run build",
    "check-all": "bun run type-check && bun run lint && bun run format:check && bun test",
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src stories scripts bin .storybook docs site README.md",
    "format:check": "prettier --check src stories scripts bin .storybook docs site README.md",
    "check": "bun run build && node bin/signagekit.js check",
    "preview": "bun scripts/preview.ts",
    "bench": "bun run build && bun scripts/bench.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "site:build": "cd site && astro build",
    "site:dev": "cd site && astro dev"
  },
  "dependencies": {
    "preact": "10.27.2",
    "uplot": "1.6.32",
    "uqr": "0.1.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@storybook/preact-vite": "10.6.5",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.13",
    "@types/jsdom": "28.0.3",
    "astro": "7.4.4",
    "eslint": "10.15.0",
    "jsdom": "28.1.0",
    "marked": "18.1.2",
    "prettier": "3.10.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "prettier": "./.prettierrc.json",
  "publishConfig": {
    "access": "public"
  }
}
